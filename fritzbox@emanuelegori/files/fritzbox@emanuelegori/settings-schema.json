{
    "connection-header": {
        "type": "header",
        "description": "FRITZ!Box connection"
    },
    "host": {
        "type": "entry",
        "default": "fritz.box",
        "description": "Address (host or IP)",
        "tooltip": "Hostname or IP of the FRITZ!Box on the LAN. Default: fritz.box"
    },
    "port": {
        "type": "spinbutton",
        "default": 49000,
        "min": 1,
        "max": 65535,
        "step": 1,
        "units": "",
        "description": "TR-064 / IGD port"
    },
    "delay": {
        "type": "spinbutton",
        "default": 5,
        "min": 2,
        "max": 3600,
        "step": 1,
        "units": "seconds",
        "description": "Refresh interval"
    },
    "timeout": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "seconds",
        "description": "Request timeout"
    },

    "params-separator": { "type": "separator" },
    "params-header": {
        "type": "header",
        "description": "Parameters to display"
    },
    "show-model": {
        "type": "checkbox",
        "default": true,
        "description": "FRITZ!Box model",
        "tooltip": "Read from /tr64desc.xml"
    },
    "show-firmware": {
        "type": "checkbox",
        "default": true,
        "description": "FRITZ!OS firmware"
    },
    "show-wan-status": {
        "type": "checkbox",
        "default": true,
        "description": "WAN physical link status"
    },
    "show-wan-type": {
        "type": "checkbox",
        "default": true,
        "description": "WAN access type (DSL/LTE/Cable/Ethernet)"
    },
    "show-max-rates": {
        "type": "checkbox",
        "default": true,
        "description": "Negotiated max down/up rates"
    },
    "show-conn-status": {
        "type": "checkbox",
        "default": true,
        "description": "Internet connection status"
    },
    "show-conn-error": {
        "type": "checkbox",
        "default": false,
        "description": "Last connection error"
    },
    "show-uptime": {
        "type": "checkbox",
        "default": true,
        "description": "Connection uptime",
        "tooltip": "Time since the last Internet connection renegotiation (not since the router was powered on). In the FRITZ!Box UI: Internet → Overview → \"Connected since …\"."
    },
    "show-public-ip": {
        "type": "checkbox",
        "default": true,
        "description": "Public IP address"
    },
    "show-bytes-total": {
        "type": "checkbox",
        "default": true,
        "description": "Total bytes sent / received",
        "tooltip": "Cumulative WAN interface counter (64-bit). Resets only on router reboot or manual counter reset. Does NOT match the daily \"online counters\" page of the FRITZ!Box UI, which is not exposed via TR-064."
    },
    "show-throughput": {
        "type": "checkbox",
        "default": true,
        "description": "Instantaneous throughput (↓ / ↑)",
        "tooltip": "Instantaneous rate in bit/s, as reported by the router itself. The FRITZ!Box UI refreshes about every 5 s: set the same polling interval here to match."
    },
    "show-update-available": {
        "type": "checkbox",
        "default": true,
        "description": "Firmware update available"
    },

    "style-separator": { "type": "separator" },
    "style-header": {
        "type": "header",
        "description": "Style"
    },
    "font": {
        "type": "fontchooser",
        "default": "Monospace Regular 15",
        "description": "Font"
    },
    "font-color": {
        "type": "colorchooser",
        "default": "rgb(238,238,236)",
        "description": "Text color"
    },
    "label-color": {
        "type": "colorchooser",
        "default": "rgb(186,189,182)",
        "description": "Label color"
    },
    "background-color": {
        "type": "colorchooser",
        "default": "rgb(46,52,54)",
        "description": "Background color"
    },
    "background-transparency": {
        "type": "scale",
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "description": "Background transparency"
    },
    "border-color": {
        "type": "colorchooser",
        "default": "rgb(85,87,83)",
        "description": "Border color"
    },
    "border-width": {
        "type": "spinbutton",
        "default": 1,
        "min": 0,
        "max": 20,
        "step": 1,
        "units": "px",
        "description": "Border width"
    }
}
