#. metadata.json->name
msgid "Weather"
msgstr "Wetter"

#. metadata.json->description
msgid ""
"Current weather and forecast for the next days (Open-Meteo) with place "
"search."
msgstr ""
"Aktuelles Wetter und Vorhersage für die nächsten Tage (Open-Meteo) mit "
"Ortssuche."

#. settings-schema.json->kopf-ort->description
msgid "Place"
msgstr "Ort"

#. settings-schema.json->ort-knopf->tooltip
msgid ""
"Opens the place search. The chosen place is then shown at the top of the "
"desklet."
msgstr "Öffnet die Ortssuche. Der gewählte Ort steht danach oben im Desklet."

#. settings-schema.json->kopf-anzeige->description
msgid "Display"
msgstr "Anzeige"

#. settings-schema.json->einheit->description
msgid "Units"
msgstr "Einheiten"

#. settings-schema.json->einheit->options
msgid "°C, km/h, mm"
msgstr "°C, km/h, mm"

#. settings-schema.json->einheit->options
msgid "°F, mph, inch"
msgstr "°F, mph, inch"

#. settings-schema.json->tage->description
msgid "Days in the forecast"
msgstr "Tage in der Vorhersage"

#. settings-schema.json->zeige-details->description
msgid "Feels-like temperature, wind and humidity"
msgstr "Gefühlte Temperatur, Wind und Luftfeuchte"

#. settings-schema.json->zeige-sonne->description
msgid "Sunrise and sunset"
msgstr "Sonnenaufgang und -untergang"

#. settings-schema.json->zeige-stunden->description
msgid "Next 24 hours as a chart (temperature and chance of rain)"
msgstr ""
"Verlauf der nächsten 24 Stunden (Temperatur und Regenwahrscheinlichkeit)"

#. settings-schema.json->zeige-hinweis->description
msgid "Note from when or until when it rains"
msgstr "Hinweis, ab wann oder bis wann es regnet"

#. settings-schema.json->zeige-luft->description
msgid "UV index and air quality"
msgstr "UV-Index und Luftqualität"

#. settings-schema.json->zeige-luft->tooltip
msgid ""
"Air quality comes from a second request to Open-Meteo (air quality service)."
" When switched off it is not sent."
msgstr ""
"Die Luftqualität kommt aus einer zweiten Abfrage bei Open-Meteo "
"(Luftqualitätsdienst). Ausgeschaltet entfällt sie."

