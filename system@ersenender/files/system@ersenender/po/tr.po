msgstr "Kendi vurgu renginiz"

#. settings-schema.json->hintergrund->description
msgid "Card colour"
msgstr "Kart rengi"

#. settings-schema.json->hintergrund->options
msgid "Dark grey"
msgstr "Koyu gri"

