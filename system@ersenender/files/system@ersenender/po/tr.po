msgid "Fan"
msgstr "Fan"

#: desklet.js:65
#, javascript-format
msgid "%s rpm"
msgstr "%s dev/dk"

#: desklet.js:66
#, javascript-format
msgid "Up for %s"
msgstr "Çalışma süresi: %s"

#: desklet.js:67
#, javascript-format
msgid "Load (1, 5, 15 min): %s"
msgstr "Yük (1, 5, 15 dk): %s"

#: desklet.js:68
#, javascript-format
msgid "Swap: %s of %s GB used"
msgstr "Takas: %s / %s GB kullanılıyor"

#: desklet.js:69
#, javascript-format
msgid "%d d"
msgstr "%d g"

#: desklet.js:70
#, javascript-format
msgid "%s h"
msgstr "%s sa"

#: desklet.js:71
#, javascript-format
msgid "%s (process %s)"
msgstr "%s (süreç %s)"

#: desklet.js:72
#, javascript-format
msgid "Share of all %d cores"
msgstr "%d çekirdeğin tümüne oranı"

#: desklet.js:73
#, javascript-format
msgid "History of the last %d seconds"
msgstr "Son %d saniyenin seyri"

#: desklet.js:169
#, javascript-format
msgid "%s%%"
msgstr "%%%s"

#. metadata.json->description
msgid ""
"CPU load with history, temperatures, fan, free disk space and memory, top "
"consumers."
msgstr ""
"İşlemci kullanımı ve seyri, sıcaklıklar, fan, boş disk ve bellek, en çok "
"kullanan süreçler."

#. settings-schema.json->kopf-anzeige->description
msgid "Display"
msgstr "Görünüm"

#. settings-schema.json->takt->units
msgid "s"
msgstr "s"

#. settings-schema.json->takt->description
msgid "Refresh every"
msgstr "Yenileme aralığı"

#. settings-schema.json->warn-ab->units
msgid "°C"
msgstr "°C"

#. settings-schema.json->warn-ab->description
msgid "Temperature red from"
msgstr "Sıcaklık uyarısı"

#. settings-schema.json->zeige-modell->description
msgid "Show processor name"
msgstr "İşlemci adını göster"

#. settings-schema.json->zeige-verlauf->description
msgid "CPU load as a history curve instead of a bar"
msgstr "İşlemci kullanımını çubuk yerine eğri olarak göster"

#. settings-schema.json->zeige-platte->description
msgid "Show free space on the system disk"
msgstr "Sistem diskindeki boş alanı göster"

#. settings-schema.json->platte-warn-ab->units
msgid "GB"
msgstr "GB"

#. settings-schema.json->platte-warn-ab->description
msgid "Warn when the system disk has less free space than"
msgstr "Boş alan bundan azsa uyar"

#. settings-schema.json->platte-warn-ab->tooltip
msgid ""
"Number and bar turn red, a note appears below and the card border turns red."
" 0 = never warn."
msgstr ""
"Sayı ve çubuk kırmızı olur, altında bir uyarı görünür ve kartın kenarı "
"kırmızıya döner. 0 = hiç uyarma."

#. settings-schema.json->platte-melden->description
msgid "Also show a notification once"
msgstr "Ayrıca bir kez bildirim göster"

#. settings-schema.json->zeige-luefter->description
msgid "Show fan speed (if the computer reports it)"
msgstr "Fan hızını göster (bilgisayar bildiriyorsa)"

#. settings-schema.json->zeige-prozesse->description
msgid "Show the top consumers of CPU time and memory"
msgstr "En çok işlemci ve bellek kullanan süreçleri göster"

#. settings-schema.json->zeige-prozesse->tooltip
msgid "For this the program top is started briefly every few seconds."
msgstr "Bunun için birkaç saniyede bir top programı kısaca çalıştırılır."

#. settings-schema.json->groesse->description
msgid "Size"
msgstr "Boyut"

#. settings-schema.json->deckkraft->description
msgid "Background opacity"
msgstr "Arka plan opaklığı"

#. settings-schema.json->kopf-farben->description
msgid "Colours"
msgstr "Renkler"

#. settings-schema.json->akzent->description
msgid "Accent colour"
msgstr "Vurgu rengi"

#. settings-schema.json->akzent->options
msgid "Yellow"
msgstr "Sarı"

#. settings-schema.json->akzent->options
