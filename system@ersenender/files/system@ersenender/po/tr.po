#. metadata.json->name
#: desklet.js:47
msgid "System"
msgstr "Sistem"

#: desklet.js:48
msgid "CPU load"
msgstr "İşlemci kullanımı"

#: desklet.js:49
msgid "System disk free"
msgstr "Sistem diskinde boş alan"

#: desklet.js:50
#, javascript-format
msgid "⚠ Less than %s GB free"
msgstr "⚠ %s GB'den az boş alan"

#: desklet.js:51
msgid "System disk almost full"
msgstr "Sistem diski dolmak üzere"

#: desklet.js:52
#, javascript-format
msgid "Only %s GB left."
msgstr "Yalnızca %s GB boş."

#: desklet.js:53
msgid "CPU temperature"
msgstr "İşlemci sıcaklığı"

#: desklet.js:54
msgid "GPU temperature"
msgstr "Ekran kartı sıcaklığı"

#: desklet.js:55
msgid "RAM free"
msgstr "Boş bellek"

#: desklet.js:56
msgid "in the processor"
msgstr "işlemcide"

#: desklet.js:57
#, javascript-format
msgid "%s of %s GB used"
msgstr "%s / %s GB kullanılıyor"

#: desklet.js:58
#, javascript-format
msgid "%d cores"
msgstr "%d çekirdek"

#: desklet.js:59
#, javascript-format
msgid "%s GB free of %s GB"
msgstr "%s GB boş (toplam %s GB)"

#: desklet.js:60
#, javascript-format
msgid "%s GB used (%s)"
msgstr "%s GB dolu (%s)"

#: desklet.js:61
#, javascript-format
msgid "Warning from %s °C"
msgstr "%s °C'den itibaren uyarı"

#: desklet.js:62
#, javascript-format
msgid "Warning below %s GB"
msgstr "%s GB altında uyarı"

#: desklet.js:63
msgid "Top consumers"
msgstr "En çok kullananlar"

