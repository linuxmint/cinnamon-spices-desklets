#. settings-schema.json->nameday-locale->description
msgid "Name day calendar"
msgstr "Nimipäiväkalenteri"

#. settings-schema.json->nameday-lookahead->description
msgid "Show upcoming name days (days ahead)"
msgstr "Tulevat nimipäivät (seuraavat päivät)"

#. settings-schema.json->nameday-two-columns->description
msgid "Show future name days in two columns"
msgstr "Tulevat nimipäivät kahdessa sarakkeessa"

#. settings-schema.json->show-wikipedia->description
msgid "Enable Wikipedia features (requires Internet)"
msgstr "Wikipedia lisäominaisuuksia (internet tarvitaan)"

#. settings-schema.json->wikipedia-lang->description
msgid "Wikipedia language"
msgstr "Wikipedia kieli"

#. settings-schema.json->show-wiki-events->description
msgid "Show notable events on this day"
msgstr "Päivän tärkeät tapahtumat"

#. settings-schema.json->show-wiki-births->description
msgid "Show notable births on this day"
msgstr "Syntymäpäiviä tänä päivänä"

#. settings-schema.json->show-wiki-deaths->description
msgid "Show notable deaths on this day"
msgstr "Kuolinpäiviä tänä päivänä"

#. settings-schema.json->show-wiki-featured->description
msgid "Show article of the day"
msgstr "Päivän lehtiartikkeli"

#. settings-schema.json->wikipedia-items-count->units
msgid "items"
msgstr "kohdetta"

#. settings-schema.json->wikipedia-items-count->description
msgid "Items shown per section"
msgstr "Kohteita per osio"

#. settings-schema.json->wikipedia-items-count->tooltip
msgid ""
"How many births, deaths, and events to display at a time. The list rotates "
"periodically, cycling through all available entries from the cache."
msgstr ""
"Kuinka monta syntymää, kuolemaa ja tapahtumaa näytetään kerrallaan. Luettelo "
"vaihtuu säännöllisesti ja käy läpi kaikki välimuistissa olevat."

#. settings-schema.json->wikipedia-rotate-minutes->units
msgid "minutes"
msgstr "minuuttia"

#. settings-schema.json->wikipedia-rotate-minutes->description
msgid "Rotate items every N minutes"
msgstr "Kierrätä kohteita minuuttivälein"

#. settings-schema.json->wikipedia-rotate-minutes->tooltip
msgid ""
"How often to advance to the next set of items. Set to 1 to rotate every "
"minute."
msgstr ""
"Kuinka usein seuraavaan. Aseta arvoksi 1, jos haluat vaihtaa sisältöä "
"minuutin välein."

#. settings-schema.json->wikipedia-cache-hours->units
msgid "hours"
msgstr "tuntia"

#. settings-schema.json->wikipedia-cache-hours->description
msgid "Cache duration for Wikipedia data"
msgstr "Wikipedia-datan säilytysaika"

#. settings-schema.json->wikipedia-cache-hours->tooltip
msgid ""
"How long to keep Wikipedia data in the local cache before fetching fresh "
"data. Lower values fetch more often; higher values reduce network usage."
msgstr ""
"Kuinka kauan Wikipedian tiedot säilytetään välimuistissa ennen uusien "
"tietojen hakemista. Pienempi arvo hakee useammin; korkeampi arvo säästää "
"verkon käyttöä."

#. settings-schema.json->icon-size->description
msgid "Icon and symbol size"
msgstr "Kuvakkeen ja symbolin koko"

#. settings-schema.json->icon-size->tooltip
msgid "Controls the display size of moon phase and zodiac symbols."
msgstr "Säätää kuunvaihe- ja horoskooppisymbolien näytetyn koon."

#. settings-schema.json->icon-size->options
msgid "Small"
msgstr "Pieni"

#. settings-schema.json->icon-size->options
msgid "Medium"
msgstr "Keskikoko"

#. settings-schema.json->icon-size->options
msgid "Large"
msgstr "Suuri"

#. settings-schema.json->text-scale->units
msgid "×"
msgstr "×"

#. settings-schema.json->text-scale->description
msgid "Text scale factor"
msgstr "Tekstin skaalauskerroin"

#. settings-schema.json->text-scale->tooltip
msgid "Scale all text in the desklet up or down."
msgstr "Muuttaa tekstin kokoa kaikkialla."

#. settings-schema.json->bg-opacity->description
msgid "Background opacity"
msgstr "Läpikuultavuus"

#. settings-schema.json->bg-opacity->tooltip
msgid ""
"0 = fully transparent (wallpaper shows through), 1 = solid black background"
msgstr "0 = täysin läpinäkyvä (taustakuva näkyy läpi), 1 = täysin musta tausta"

#. settings-schema.json->show-julian->description
msgid "Show Julian calendar date"
msgstr "Päivämäärä juliaanisen kalenterin mukaan"

#. settings-schema.json->show-hebrew->description
msgid "Show Hebrew calendar date"
msgstr "Päivämäärä heprealaisen kalenterin mukaan"

#. settings-schema.json->show-islamic->description
msgid "Show Islamic calendar date"
msgstr "Päivämäärä islamilaisen kalenterin mukaan"

#. settings-schema.json->show-persian->description
msgid "Show Persian calendar date"
msgstr "Päivämäärä persialaisen kalenterin mukaan"
