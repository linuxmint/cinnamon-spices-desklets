{
    "layout": {
        "type": "layout",
        "pages": ["page-data", "page-look"],
        "page-data": {
            "type": "page",
            "title": "Ubicación y datos",
            "sections": ["sec-location", "sec-data"]
        },
        "page-look": {
            "type": "page",
            "title": "Apariencia",
            "sections": ["sec-theme", "sec-show"]
        },
        "sec-location": {
            "type": "section",
            "title": "Ubicación",
            "keys": ["city"]
        },
        "sec-data": {
            "type": "section",
            "title": "Datos",
            "keys": ["units", "refresh_min", "language"]
        },
        "sec-theme": {
            "type": "section",
            "title": "Estilo",
            "keys": ["theme", "opacity", "ui_scale"]
        },
        "sec-show": {
            "type": "section",
            "title": "Qué mostrar",
            "keys": ["show_details", "show_hourly", "hours", "show_daily", "days", "clock_24h"]
        }
    },
    "city": {
        "type": "entry",
        "default": "",
        "description": "Ciudad (vacío = detectar automáticamente)",
        "tooltip": "Ejemplos: Medellín, Madrid, Tokyo. Si lo dejas vacío se detecta por tu conexión a internet."
    },
    "units": {
        "type": "combobox",
        "default": "metric",
        "description": "Unidades",
        "options": {
            "Métrico (°C, km/h)": "metric",
            "Imperial (°F, mph)": "imperial"
        }
    },
    "refresh_min": {
        "type": "spinbutton",
        "default": 30,
        "min": 10,
        "max": 180,
        "step": 5,
        "units": "min",
        "description": "Actualizar cada"
    },
    "language": {
        "type": "combobox",
        "default": "es",
        "description": "Idioma",
        "options": {
            "Español": "es",
            "English": "en"
        }
    },
    "theme": {
        "type": "combobox",
        "default": "auto",
        "description": "Tema",
        "options": {
            "Automático (según el clima)": "auto",
            "Oscuro": "dark",
            "Claro": "light",
            "Cristal translúcido": "glass"
        }
    },
    "opacity": {
        "type": "scale",
        "default": 92,
        "min": 30,
        "max": 100,
        "step": 1,
        "show-value": true,
        "description": "Opacidad del fondo (%)"
    },
    "ui_scale": {
        "type": "scale",
        "default": 100,
        "min": 70,
        "max": 150,
        "step": 5,
        "show-value": true,
        "description": "Tamaño (%)"
    },
    "show_details": {
        "type": "switch",
        "default": true,
        "description": "Mostrar detalles (sensación, humedad, viento, presión, UV, sol)"
    },
    "show_hourly": {
        "type": "switch",
        "default": true,
        "description": "Mostrar curva de temperatura por horas"
    },
    "hours": {
        "type": "spinbutton",
        "default": 8,
        "min": 4,
        "max": 12,
        "step": 1,
        "units": "horas",
        "description": "Horas a mostrar",
        "dependency": "show_hourly"
    },
    "show_daily": {
        "type": "switch",
        "default": true,
        "description": "Mostrar pronóstico de los próximos días"
    },
    "days": {
        "type": "spinbutton",
        "default": 5,
        "min": 3,
        "max": 7,
        "step": 1,
        "units": "días",
        "description": "Días a mostrar",
        "dependency": "show_daily"
    },
    "clock_24h": {
        "type": "switch",
        "default": true,
        "description": "Reloj de 24 horas"
    }
}
