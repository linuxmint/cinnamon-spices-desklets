msgstr "Alarme vorlesen"

#. settings-schema.json->sprache-an->tooltip
msgid "Uses the Piper voice when installed (install.sh --stimme), otherwise spd-say."
msgstr "Nutzt die Piper-Stimme, wenn eingerichtet (install.sh --stimme), sonst spd-say."

#. settings-schema.json->sprache-ab->description
msgid "Read aloud from level"
msgstr "Vorlesen ab Stufe"

#. settings-schema.json->sprache-ab->options
msgid "All alarms (info and up)"
msgstr "Alle Alarme (ab Info)"

#. settings-schema.json->sprache-ab->options
msgid "Warnings and trade entries"
msgstr "Warnungen und Trade-Einstiege"

#. settings-schema.json->sprache-ab->options
msgid "Only trade entries"
msgstr "Nur Trade-Einstiege"

#. settings-schema.json->ruhe-an->description
msgid "Quiet hours (notification only, no sound or speech)"
msgstr "Ruhezeit (nur Benachrichtigung, ohne Ton und Sprache)"

#. settings-schema.json->ruhe-von->description
msgid "Quiet from"
msgstr "Ruhe ab"

#. settings-schema.json->ruhe-von->units
msgid "h"
msgstr "Uhr"

#. settings-schema.json->ruhe-bis->description
msgid "Quiet until"
msgstr "Ruhe bis"

