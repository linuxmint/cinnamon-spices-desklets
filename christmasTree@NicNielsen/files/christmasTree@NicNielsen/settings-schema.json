{
    "layout": {
        "type": "layout",
        "pages": ["page1"],
        "page1": {
            "type": "page",
            "title": "Christmas Tree Settings",
            "sections": ["section_size", "section_tree", "section_lights", "section_star"]
        },
        "section_size": {
            "type": "section",
            "title": "Desklet Size",
            "keys": ["desklet-scale"]
        },
        "section_tree": {
            "type": "section",
            "title": "Tree Appearance",
            "keys": ["tree-color", "tree-opacity"]
        },
        "section_lights": {
            "type": "section",
            "title": "Animation & Lights",
            "keys": ["blink-speed", "number-of-lights"]
        },
        "section_star": {
            "type": "section",
            "title": "Top Star",
            "keys": ["show-star", "star-color"]
        }
    },
    "desklet-scale": {
        "type": "scale",
        "default": 1.0,
        "min": 0.5,
        "max": 2.5,
        "step": 0.05,
        "label": "Size Scale",
        "description": "Adjust the overall scale size of the Christmas Tree"
    },
    "tree-color": {
        "type": "colorchooser",
        "default": "#00FF00",
        "description": "Tree Color"
    },
    "tree-opacity": {
        "type": "scale",
        "default": 1.0,
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "label": "Tree Transparency",
        "description": "Adjust the background transparency of the tree"
    },
    "blink-speed": {
        "type": "spinbutton",
        "default": 500,
        "min": 100,
        "max": 3000,
        "step": 50,
        "units": "ms",
        "description": "Blink Speed"
    },
    "number-of-lights": {
        "type": "spinbutton",
        "default": 20,
        "min": 0,
        "max": 50,
        "step": 1,
        "units": "lights",
        "description": "Number of Lights"
    },
    "show-star": {
        "type": "checkbox",
        "default": true,
        "description": "Show Star"
    },
    "star-color": {
        "type": "colorchooser",
        "default": "#FFFF00",
        "description": "Star Color",
        "dependency": "show-star"
    }
}

