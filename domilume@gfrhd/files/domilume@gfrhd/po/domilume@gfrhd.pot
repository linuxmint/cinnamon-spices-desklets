#. settings-schema.json->status-notfound->description
msgid ""
"✗ No FRITZ!Box found. Is this computer in the same network? Otherwise enter "
"the address by hand,\n"
"e.g. 192.168.178.1 (printed on the bottom of the box, or the gateway in the "
"network settings)."
msgstr ""

#. settings-schema.json->status-ok->description
msgid ""
"✓ Connected to the FRITZ!Box. The devices are listed on the “Devices” page."
msgstr ""

#. settings-schema.json->status-no-address->description
msgid "No address yet. Enter it above or click “Search automatically”."
msgstr ""

#. settings-schema.json->status-no-credentials->description
msgid "No credentials yet. Click “Set credentials…”."
msgstr ""

#. settings-schema.json->status-login-failed->description
msgid "✗ Login failed: wrong user name or password."
msgstr ""

#. settings-schema.json->status-blocked->description
msgid ""
"✗ After failed attempts the FRITZ!Box blocks the login for a while. Please "
"wait a moment."
msgstr ""

#. settings-schema.json->status-unreachable->description
msgid ""
"✗ No FRITZ!Box answers at this address. Check the address or use “Search "
"automatically”."
msgstr ""

#. settings-schema.json->status-no-right->description
msgid ""
"✗ The user may not access Smart Home.\n"
"In the FRITZ!Box, give the user the “Smart Home” permission under System → "
"FRITZ!Box Users."
msgstr ""

