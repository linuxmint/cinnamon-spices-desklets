#. metadata.json->name
msgid "Twitch.tv channel status"
msgstr "Twitch.tv kanavien tila"

#. metadata.json->description
msgid "Get live status of Twitch channels."
msgstr "Hae Twitch-kanavien reaaliaikainen tila (onko katsottavaa?)."

#. settings-schema.json->head0->description
msgid "Channel options"
msgstr "Kanavan asetuksia"

#. settings-schema.json->channel->description
msgid "Twitch channel"
msgstr "Twitch kanava"

#. settings-schema.json->channel->tooltip
msgid "Channel name can be found in the twitch url."
msgstr "Kanavan nimi löytyy Twitch-osoitteesta."

#. settings-schema.json->channel_name->description
msgid "Display name"
msgstr "Näyttönimi"

#. settings-schema.json->refresh_rate->description
msgid "Refresh rate"
msgstr "Päivitysväli"

#. settings-schema.json->refresh_rate->units
#. settings-schema.json->refresh_rate_online->units
msgid "minutes"
msgstr "min"

#. settings-schema.json->refresh_rate_option->description
#. settings-schema.json->refresh_rate_online->description
msgid "Online refresh rate"
msgstr "Päivitysväliä verkkotilassa"

#. settings-schema.json->refresh_rate_option->tooltip
msgid ""
"This option allows you to adjust the refresh rate for when the channel is "
"online, which can help save data transfer."
msgstr ""
"Tämän avulla voit säätää päivitysväliä kanavan ollessa aktiivinen, mikä "
"säästää tiedonsiirrossa."

#. settings-schema.json->head1->description
msgid "Desklet UI"
msgstr "Käyttöliittymä"

#. settings-schema.json->use_custom_size->description
msgid "Custom width and height"
msgstr "Mukautettu leveys ja korkeus"

#. settings-schema.json->use_custom_size->tooltip
msgid "Checking this box allows you to set custom size."
msgstr "Valitsemalla voit määrittää mukautetun koon."

#. settings-schema.json->width->description
msgid "Width"
msgstr "Leveys"

#. settings-schema.json->width->units
#. settings-schema.json->height->units
msgid "pixels"
msgstr "pikseliä"

#. settings-schema.json->height->description
msgid "Height"
msgstr "Korkeus"

#. settings-schema.json->hide_decorations->description
msgid "Custom style"
msgstr "Mukautettu tyyli"

#. settings-schema.json->hide_decorations->tooltip
msgid ""
"Selecting this option allows for UI customization by ignoring the Cinnamon "
"theme and style."
msgstr ""
"Valitsemalla käyttöliittymän mukauttamisen se jättää Cinnamon-teeman ja -"
"tyylin huomiotta."

#. settings-schema.json->border_radius->description
msgid "Border radius"
msgstr "Reunojen pyöristys"

#. settings-schema.json->border_radius->tooltip
msgid "Radius for rounding the desklet's corners"
msgstr "Kulmien pyöristyssäde työpöydällä"

#. settings-schema.json->padding_vertical->description
msgid "Vertical padding"
msgstr "Pystytäyte"

#. settings-schema.json->padding_vertical->tooltip
#. settings-schema.json->padding_horizontal->tooltip
msgid "The extra space around the container"
msgstr "Ympärillä oleva ylimääräinen tila"

#. settings-schema.json->padding_horizontal->description
msgid "Horizontal padding"
msgstr "Vaakatäyte"

#. settings-schema.json->bg_color->description
msgid "Background color"
msgstr "Taustaväri"
