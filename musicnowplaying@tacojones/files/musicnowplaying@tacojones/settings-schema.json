{
    "player": {
        "type": "entry",
        "description": "Player",
        "tooltip": "The player to show, by its MPRIS name: audacious, rhythmbox, spotify, vlc, strawberry… While another player is playing and this one isn't, that one is shown.",
        "default": "audacious"
    },
    "width": {
        "type": "spinbutton",
        "description": "Width",
        "min": 160,
        "max": 600,
        "step": 10,
