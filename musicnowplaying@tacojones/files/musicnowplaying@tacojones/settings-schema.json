        "default": 300
    },
    "background-opacity": {
        "type": "scale",
        "description": "Background opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "digits": 0,
        "units": "%",
        "default": 90
    },
    "corner-radius": {
        "type": "spinbutton",
        "description": "Corner radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "units": "pixels",
        "default": 12
    }
}
