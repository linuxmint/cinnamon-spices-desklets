{
    "head": {
        "type": "header",
        "description": "Claude Usage"
    },
    "refresh-minutes": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "minutes",
        "description": "Refresh interval"
    },
    "width": {
        "type": "spinbutton",
        "default": 300,
        "min": 200,
        "max": 800,
        "step": 10,
        "units": "px",
        "description": "Desklet width"
    },
    "font-scale": {
        "type": "scale",
        "default": 1.0,
        "min": 0.7,
        "max": 1.8,
        "step": 0.1,
        "description": "Text size"
    },
    "background-opacity": {
        "type": "scale",
        "default": 0.75,
        "min": 0.0,
        "max": 1.0,
        "step": 0.05,
        "description": "Background opacity"
    },
    "show-reset-times": {
        "type": "checkbox",
        "default": true,
        "description": "Show when each limit resets"
    },
    "show-spend": {
        "type": "checkbox",
        "default": true,
        "description": "Show extra-usage spend when enabled on the account"
    },
    "credentials-path": {
        "type": "entry",
        "default": "~/.claude/.credentials.json",
        "description": "Claude Code credentials file",
        "tooltip": "Written by Claude Code when you log in. The desklet only reads it."
    }
}
