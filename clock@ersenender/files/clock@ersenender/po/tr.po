#. metadata.json->name
#. settings-schema.json->kopf-uhr->description
msgid "Clock"
msgstr "Saat"

#. metadata.json->description
msgid "Clock with date, analog or digital - with alarm and timer."
msgstr "Tarihli saat, analog veya dijital - alarm ve zamanlayıcı ile."

#. settings-schema.json->art->description
msgid "Display"
msgstr "Görünüm"

