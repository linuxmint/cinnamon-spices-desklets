#. metadata.json->name
#. settings-schema.json->kopf-uhr->description
msgid "Clock"
msgstr "Uhr"

#. metadata.json->description
msgid "Clock with date, analog or digital - with alarm and timer."
msgstr "Uhr mit Datum, analog oder digital - mit Wecker und Timer."

#. settings-schema.json->art->description
msgid "Display"
msgstr "Anzeige"

#. settings-schema.json->art->options
msgid "Analog (hands)"
msgstr "Analog (Zeiger)"

#. settings-schema.json->art->options
