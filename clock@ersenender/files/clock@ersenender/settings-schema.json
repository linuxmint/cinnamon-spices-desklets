{
    "kopf-uhr": {
        "type": "header",
        "description": "Clock"
    },
    "art": {
        "type": "combobox",
        "default": "analog",
        "description": "Display",
        "options": {
            "Analog (hands)": "analog",
            "Digital (digits)": "digital"
        }
    },
    "zifferblatt": {
        "type": "combobox",
        "default": "ziffern",
        "dependency": "art=analog",
        "description": "Dial",
        "options": {
            "Arabic numerals (1, 2, 3 …)": "ziffern",
            "Eastern Arabic numerals (١, ٢, ٣ …)": "ostarabisch",
            "Roman numerals (I, II, III …)": "roemisch",
            "Marks": "striche"
        }
    },
    "uhr-groesse": {
        "type": "scale",
        "default": 160,
        "min": 80,
        "max": 320,
        "step": 4,
        "dependency": "art=analog",
        "description": "Clock diameter"
    },
    "sekunden": {
        "type": "switch",
        "default": true,
        "description": "Show seconds"
    },
    "zeige-datum": {
        "type": "switch",
        "default": true,
        "description": "Date below the clock"
    },
    "format12": {
        "type": "switch",
        "default": false,
        "description": "12-hour digital display (AM/PM)"
    },
    "zeige-kw": {
        "type": "switch",
        "default": false,
        "dependency": "zeige-datum",
        "description": "Calendar week after the date"
    },
    "kopf-wecker": {
        "type": "header",
        "description": "Alarm and timer"
    },
    "wecker": {
        "type": "switch",
        "default": false,
        "description": "Alarm"
    },
    "wecker-std": {
        "type": "spinbutton",
        "default": 7,
        "min": 0,
        "max": 23,
        "step": 1,
        "units": "h",
        "dependency": "wecker",
        "description": "Alarm time: hour"
    },
    "wecker-min": {
        "type": "spinbutton",
        "default": 0,
        "min": 0,
        "max": 59,
        "step": 1,
        "units": "min",
        "dependency": "wecker",
        "description": "Alarm time: minute"
    },
    "wecker-tage": {
        "type": "combobox",
        "default": "alle",
        "dependency": "wecker",
        "description": "Ring on",
        "options": {
            "Every day": "alle",
            "Monday to Friday": "werktags"
        }
    },
    "timer-eigen": {
        "type": "spinbutton",
        "default": 45,
        "min": 1,
        "max": 600,
        "step": 1,
        "units": "min",
        "description": "Custom timer length in the right-click menu",
        "tooltip": "Start the timer with a right-click on the desklet: 5, 10, 15, 30, 60 minutes or this length."
    },
    "ton": {
        "type": "switch",
        "default": true,
        "description": "Play a sound"
    },
    "melden": {
        "type": "switch",
        "default": true,
        "description": "Also show a notification"
    },
    "timer-ende": {
        "type": "generic",
        "default": 0
    },
    "timer-dauer": {
        "type": "generic",
        "default": 0
    },
    "kopf-anzeige": {
        "type": "header",
        "description": "Appearance"
    },
    "groesse": {
        "type": "scale",
        "default": 1.0,
        "min": 0.8,
        "max": 2.5,
        "step": 0.05,
        "description": "Font size (digital clock too)"
    },
    "deckkraft": {
        "type": "scale",
        "default": 0.82,
        "min": 0.0,
        "max": 1.0,
        "step": 0.02,
        "description": "Background opacity"
    },
    "kopf-farben": {
        "type": "header",
        "description": "Colours"
    },
    "akzent": {
        "type": "combobox",
        "default": "gelb",
        "description": "Accent colour",
        "options": {
            "Yellow": "gelb",
            "Red": "rot",
            "Orange": "orange",
            "Green": "gruen",
            "Teal": "tuerkis",
            "Blue": "blau",
            "Purple": "violett",
            "Own colour": "eigen"
        }
    },
    "akzent-eigen": {
        "type": "colorchooser",
        "default": "#ffcb08",
        "dependency": "akzent=eigen",
        "description": "Own accent colour"
    },
    "hintergrund": {
        "type": "combobox",
        "default": "grau",
        "description": "Card colour",
        "options": {
            "Dark grey": "grau",
            "Dark teal": "tuerkis",
            "Dark blue": "blau",
            "Black": "schwarz"
        }
    }
}
