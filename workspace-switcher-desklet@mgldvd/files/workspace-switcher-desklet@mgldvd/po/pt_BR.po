#. metadata.json->name
msgid "Workspace Switcher Desklet"
msgstr "Alterador de espaço de trabalho (desklet)"

#. metadata.json->description
msgid "One translucent rectangle per workspace on your desktop. Click or scroll to switch. Fully customizable: colors, borders, size, labels, position and multi-monitor."
msgstr "Um retângulo translúcido para cada espaço de trabalho na sua área de trabalho. Clique ou role para trocar. Totalmente personalizável: cores, bordas, tamanho, etiquetas, posição e vários monitores."

