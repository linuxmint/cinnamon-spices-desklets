#. metadata.json->name
msgid "Rates and Metals"
msgstr "Döviz ve Altın"

#. metadata.json->description
msgid ""
"Exchange rates (ECB) and precious metal prices as a list - choose in the "
"settings what is shown."
msgstr ""
"Döviz kurları (AMB) ve değerli maden fiyatları liste hâlinde – neyin "
"gösterileceği ayarlardan seçilir."

#. settings-schema.json->kopf-basis->description
msgid "Basis"
msgstr "Temel"

#. settings-schema.json->basis->description
msgid "Base currency"
msgstr "Ana para birimi"

#. settings-schema.json->basis->options
msgid "Euro (EUR)"
msgstr "Euro (EUR)"

#. settings-schema.json->basis->options
msgid "US dollar (USD)"
msgstr "ABD Doları (USD)"

#. settings-schema.json->basis->options
msgid "Turkish lira (TRY)"
