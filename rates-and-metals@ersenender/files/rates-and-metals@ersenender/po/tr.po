msgstr "İngiliz Sterlini (GBP)"

#. settings-schema.json->basis->options
msgid "Swiss franc (CHF)"
msgstr "İsviçre Frangı (CHF)"

#. settings-schema.json->richtung->description
msgid "Show exchange rate as"
msgstr "Kur gösterimi"

#. settings-schema.json->richtung->options
msgid "1 base = … foreign (1 € = 1,12 $)"
msgstr "1 ana para = … döviz (1 € = 1,12 $)"

#. settings-schema.json->richtung->options
msgid "1 foreign = … base (1 $ = 0,89 €)"
msgstr "1 döviz = … ana para (1 $ = 0,89 €)"

#. settings-schema.json->betrag->description
msgid "Amount to convert"
msgstr "Çevrilecek tutar"

#. settings-schema.json->betrag->tooltip
msgid ""
"The currency rows show the value of this amount (e.g. 100 € = 117.77 $)."
msgstr "Döviz satırları bu tutarın değerini gösterir (ör. 100 € = 117,77 $)."

