msgid "Basis"
msgstr "Grundlage"

#. settings-schema.json->basis->description
msgid "Base currency"
msgstr "Basiswährung"

#. settings-schema.json->basis->options
msgid "Euro (EUR)"
msgstr "Euro (EUR)"

#. settings-schema.json->basis->options
msgid "US dollar (USD)"
msgstr "US-Dollar (USD)"

#. settings-schema.json->basis->options
