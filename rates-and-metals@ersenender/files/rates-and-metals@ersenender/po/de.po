msgid "Currencies"
msgstr "Währungen"

#. settings-schema.json->waehrungen->description
#. settings-schema.json->metalle->description
msgid "Tick = show, arrows change the order"
msgstr "Haken = anzeigen, mit den Pfeilen die Reihenfolge ändern"

#. settings-schema.json->waehrungen->tooltip
msgid "The base currency itself is not listed."
msgstr "Die Basiswährung selbst erscheint nicht in der Anzeige."

#. settings-schema.json->waehrungen->columns->title
