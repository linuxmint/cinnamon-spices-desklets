{
  "layout": {
    "type": "layout",
    "pages": [
      "connection",
      "photos",
      "caption",
      "look"
    ],
    "connection": {
      "type": "page",
      "title": "Connection",
      "sections": [
        "conn",
        "perm"
      ]
    },
    "photos": {
      "type": "page",
      "title": "Photos",
      "sections": [
        "lists",
        "filters",
        "sched"
      ]
    },
    "caption": {
      "type": "page",
      "title": "Text",
      "sections": [
        "text-parts",
        "text-look"
      ]
    },
    "look": {
      "type": "page",
      "title": "Appearance",
      "sections": [
        "size",
        "style",
        "trans"
      ]
    },
    "conn": {
      "type": "section",
      "title": "Immich server",
      "keys": [
        "server-url",
        "api-key",
        "fetch-now"
      ]
    },
    "perm": {
      "type": "section",
      "title": "API key permissions",
      "keys": [
        "perm-help",
        "permissions",
        "open-keys"
      ]
    },
    "lists": {
      "type": "section",
      "title": "People, albums and tags",
      "keys": [
        "lists-help",
        "fetch-lists",
        "people",
        "albums",
        "tags"
      ]
    },
    "filters": {
      "type": "section",
      "title": "Which photos",
      "keys": [
        "on-this-day",
        "favorites",
        "min-rating",
        "period",
        "year-from",
        "year-to",
        "places",
        "query",
        "include-screenshots"
      ]
    },
    "sched": {
      "type": "section",
      "title": "Updates",
      "keys": [
        "count",
        "refresh-hours",
        "delay"
      ]
    },
    "text-parts": {
      "type": "section",
      "title": "What to show",
      "keys": [
        "caption",
        "show-date",
        "date-format",
        "show-years-ago",
        "show-place",
        "place",
        "show-names",
        "show-description"
      ]
    },
    "text-look": {
      "type": "section",
      "title": "Look",
      "keys": [
        "caption-position",
        "caption-size",
        "caption-shadow",
        "caption-bg",
        "caption-bg-opacity",
        "caption-bg-radius"
      ]
    },
    "size": {
      "type": "section",
      "title": "Size",
      "keys": [
        "width",
        "height"
      ]
    },
    "style": {
      "type": "section",
      "title": "Style",
      "keys": [
        "radius",
        "smart-crop",
        "ken-burns",
        "ken-burns-faces-only",
        "ken-burns-speed"
      ]
    },
    "trans": {
      "type": "section",
      "title": "Transitions",
      "keys": [
        "trans-help",
        "t-fade",
        "t-slide-left",
        "t-slide-right",
        "t-slide-up",
        "t-slide-down",
        "t-zoom",
        "t-flip",
        "trans-order",
        "fade"
      ]
    }
  },
  "server-url": {
    "type": "entry",
    "default": "",
    "description": "Server address",
    "tooltip": "For example http://192.168.1.10:2283 or https://photos.example.com"
  },
  "api-key": {
    "type": "entry",
    "default": "",
    "description": "API key",
    "tooltip": "Immich → Account Settings → API Keys → New API Key"
  },
  "fetch-now": {
    "type": "button",
    "description": "Fetch new photos now",
    "callback": "on_fetch_now"
  },
  "perm-help": {
    "type": "label",
    "description": "When you create the API key in Immich, tick exactly the permissions below. The list follows your choices in these settings."
  },
  "permissions": {
    "type": "textview",
    "height": 120,
    "default": "asset.read, asset.view, face.read",
    "description": "Permissions the key needs",
    "tooltip": "Filled in automatically from your choices"
  },
  "open-keys": {
    "type": "button",
    "description": "Open API keys in Immich",
    "callback": "on_open_keys"
  },
  "lists-help": {
    "type": "label",
    "description": "Tick the people, albums and tags to show. Nothing ticked means all. Fetching the lists needs person.read, album.read and tag.read, and asset.statistics to count the photos of each person and tag."
  },
  "fetch-lists": {
    "type": "button",
    "description": "Fetch people, albums and tags from Immich",
    "callback": "on_fetch_lists"
  },
  "people": {
    "type": "list",
    "default": [],
    "description": "People",
    "show-buttons": false,
    "height": 160,
    "columns": [
      { "id": "use", "title": "Show", "type": "boolean" },
      { "id": "name", "title": "Person", "type": "string" },
      { "id": "count", "title": "Photos", "type": "string", "align": 1.0 }
    ]
  },
  "albums": {
    "type": "list",
    "default": [],
    "description": "Albums",
    "show-buttons": false,
    "height": 120,
    "columns": [
      { "id": "use", "title": "Show", "type": "boolean" },
      { "id": "name", "title": "Album", "type": "string" },
      { "id": "count", "title": "Photos", "type": "string", "align": 1.0 }
    ]
  },
  "tags": {
    "type": "list",
    "default": [],
    "description": "Tags",
    "show-buttons": false,
    "height": 100,
    "columns": [
      { "id": "use", "title": "Show", "type": "boolean" },
      { "id": "name", "title": "Tag", "type": "string" },
      { "id": "count", "title": "Photos", "type": "string", "align": 1.0 }
    ]
  },
  "on-this-day": {
    "type": "switch",
    "default": false,
    "description": "On this day",
    "tooltip": "Photos taken on today's date in earlier years. Falls back to the other choices when there are none."
  },
  "favorites": {
    "type": "switch",
    "default": false,
    "description": "Favorites only"
  },
  "min-rating": {
    "type": "spinbutton",
    "default": 0,
    "min": 0,
    "max": 5,
    "step": 1,
    "units": "stars",
    "description": "At least",
    "tooltip": "0 means any rating"
  },
  "period": {
    "type": "combobox",
    "default": "all",
    "description": "Taken",
    "options": {
      "Any time": "all",
      "In the last 12 months": "last-year",
      "In the last 5 years": "last-5-years",
      "Between the years below": "years"
    }
  },
  "year-from": {
    "type": "spinbutton",
    "default": 2015,
    "min": 1900,
    "max": 2100,
    "step": 1,
    "units": "",
    "description": "From year",
    "dependency": "period=years"
  },
  "year-to": {
    "type": "spinbutton",
    "default": 2025,
    "min": 1900,
    "max": 2100,
    "step": 1,
    "units": "",
    "description": "To year",
    "dependency": "period=years"
  },
  "places": {
    "type": "entry",
    "default": "",
    "description": "Places",
    "tooltip": "Cities or countries as Immich names them, separated by commas, for example Bergen, Spain"
  },
  "query": {
    "type": "entry",
    "default": "",
    "description": "Search for",
    "tooltip": "Uses Immich smart search, for example beach, snow or sunset"
  },
  "include-screenshots": {
    "type": "switch",
    "default": false,
    "description": "Include screenshots and saved images",
    "tooltip": "Off: only photos taken with a camera"
  },
  "count": {
    "type": "spinbutton",
    "default": 40,
    "min": 5,
    "max": 500,
    "step": 5,
    "units": "photos",
    "description": "Photos per batch"
  },
  "refresh-hours": {
    "type": "spinbutton",
    "default": 6,
    "min": 1,
    "max": 168,
    "step": 1,
    "units": "hours",
    "description": "Fetch a new batch every"
  },
  "delay": {
    "type": "spinbutton",
    "default": 30,
    "min": 5,
    "max": 3600,
    "step": 5,
    "units": "seconds",
    "description": "Time per photo"
  },
  "caption": {
    "type": "switch",
    "default": true,
    "description": "Show text on the photo"
  },
  "show-date": {
    "type": "switch",
    "default": true,
    "description": "Date",
    "dependency": "caption"
  },
  "date-format": {
    "type": "combobox",
    "default": "%-d %B %Y",
    "description": "Date format",
    "dependency": "show-date",
    "options": {
      "27 July 2023": "%-d %B %Y",
      "27. July 2023": "%-d. %B %Y",
      "July 27, 2023": "%B %-d, %Y",
      "July 2023": "%B %Y",
      "2023": "%Y",
      "2023-07-27": "%Y-%m-%d"
    }
  },
  "show-years-ago": {
    "type": "switch",
    "default": false,
    "description": "How long ago (5 years ago)",
    "dependency": "caption"
  },
  "show-place": {
    "type": "switch",
    "default": true,
    "description": "Place",
    "dependency": "caption"
  },
  "place": {
    "type": "combobox",
    "default": "city",
    "description": "Place format",
    "dependency": "show-place",
    "options": {
      "City": "city",
      "City, country": "city-country",
      "Country": "country"
    }
  },
  "show-names": {
    "type": "switch",
    "default": false,
    "description": "Names of the people in the photo",
    "dependency": "caption"
  },
  "show-description": {
    "type": "switch",
    "default": false,
    "description": "Description from Immich",
    "dependency": "caption"
  },
  "caption-position": {
    "type": "combobox",
    "default": "bottom-left",
    "description": "Position",
    "dependency": "caption",
    "options": {
      "Bottom left": "bottom-left",
      "Bottom centre": "bottom-center",
      "Bottom right": "bottom-right",
      "Top left": "top-left",
      "Top centre": "top-center",
      "Top right": "top-right"
    }
  },
  "caption-size": {
    "type": "spinbutton",
    "default": 10.5,
    "min": 6,
    "max": 30,
    "step": 0.5,
    "units": "pt",
    "description": "Text size",
    "dependency": "caption"
  },
  "caption-shadow": {
    "type": "switch",
    "default": true,
    "description": "Text shadow",
    "dependency": "caption"
  },
  "caption-bg": {
    "type": "switch",
    "default": false,
    "description": "Background behind the text",
    "dependency": "caption"
  },
  "caption-bg-opacity": {
    "type": "spinbutton",
    "default": 45,
    "min": 5,
    "max": 100,
    "step": 5,
    "units": "%",
    "description": "Background opacity",
    "dependency": "caption-bg"
  },
  "caption-bg-radius": {
    "type": "spinbutton",
    "default": 8,
    "min": 0,
    "max": 40,
    "step": 1,
    "units": "px",
    "description": "Background corner radius",
    "dependency": "caption-bg"
  },
  "width": {
    "type": "spinbutton",
    "default": 400,
    "min": 100,
    "max": 2000,
    "step": 10,
    "units": "px",
    "description": "Width"
  },
  "height": {
    "type": "spinbutton",
    "default": 240,
    "min": 100,
    "max": 2000,
    "step": 10,
    "units": "px",
    "description": "Height"
  },
  "radius": {
    "type": "spinbutton",
    "default": 16,
    "min": 0,
    "max": 100,
    "step": 2,
    "units": "px",
    "description": "Corner radius"
  },
  "smart-crop": {
    "type": "switch",
    "default": true,
    "description": "Crop around faces",
    "tooltip": "Uses Immich face detection so heads are not cut off."
  },
  "ken-burns": {
    "type": "switch",
    "default": false,
    "description": "Slow zoom (Ken Burns)",
    "tooltip": "Zooms slowly towards the people while a photo is shown"
  },
  "ken-burns-faces-only": {
    "type": "switch",
    "default": false,
    "description": "Only photos with faces",
    "tooltip": "Photos without people are shown without zoom",
    "dependency": "ken-burns"
  },
  "ken-burns-speed": {
    "type": "spinbutton",
    "default": 12,
    "min": 2,
    "max": 40,
    "step": 2,
    "units": "% per 10 s",
    "description": "Zoom speed",
    "tooltip": "How much the photo zooms in every 10 seconds. It stops at 50 %.",
    "dependency": "ken-burns"
  },
  "trans-help": {
    "type": "label",
    "description": "Tick the transitions to use. With several ticked, the widget changes between them."
  },
  "t-fade": {
    "type": "switch",
    "default": true,
    "description": "Fade"
  },
  "t-slide-left": {
    "type": "switch",
    "default": false,
    "description": "Slide to the left"
  },
  "t-slide-right": {
    "type": "switch",
    "default": false,
    "description": "Slide to the right"
  },
  "t-slide-up": {
    "type": "switch",
    "default": false,
    "description": "Slide up"
  },
  "t-slide-down": {
    "type": "switch",
    "default": false,
    "description": "Slide down"
  },
  "t-zoom": {
    "type": "switch",
    "default": false,
    "description": "Zoom"
  },
  "t-flip": {
    "type": "switch",
    "default": false,
    "description": "Flip"
  },
  "trans-order": {
    "type": "combobox",
    "default": "random",
    "description": "Order",
    "options": {
      "Random": "random",
      "In turn": "in-turn"
    }
  },
  "fade": {
    "type": "spinbutton",
    "default": 800,
    "min": 0,
    "max": 5000,
    "step": 100,
    "units": "ms",
    "description": "Transition duration"
  },
  "hidden-photos": {
    "type": "generic",
    "default": []
  }
}
