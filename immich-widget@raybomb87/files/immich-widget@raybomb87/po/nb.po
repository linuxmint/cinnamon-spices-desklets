#: desklet.js:101
msgid "Right-click and choose Configure to connect to your Immich server."
msgstr "Høyreklikk og velg Konfigurer for å koble til Immich-serveren din."

#: desklet.js:103
msgid "Fetching photos…"
msgstr "Henter bilder …"

#: desklet.js:105
msgid "No photos yet."
msgstr "Ingen bilder ennå."

#: desklet.js:232
msgid "The server address is not valid."
msgstr "Serveradressen er ikke gyldig."

#: desklet.js:244
msgid "Cannot reach Immich: %s"
msgstr "Får ikke kontakt med Immich: %s"

#: desklet.js:248
msgid "Immich rejected the API key."
msgstr "Immich godtok ikke API-nøkkelen."

#: desklet.js:253
msgid "Immich: %s"
msgstr "Immich: %s"

#: desklet.js:264
msgid "Album not found: %s"
msgstr "Fant ikke albumet: %s"

#: desklet.js:269
msgid "Person not found: %s"
msgstr "Fant ikke personen: %s"

#: desklet.js:389
msgid "No photos found."
msgstr "Fant ingen bilder."

#: desklet.js:411
msgid "No photos could be downloaded."
msgstr "Ingen bilder kunne lastes ned."

msgid "Immich Widget"
msgstr "Immich Widget"

msgid "A photo slideshow on your desktop with photos from your Immich server"
msgstr ""
"Lysbildefremvisning på skrivebordet med bilder fra Immich-serveren din"

msgid "Connection"
msgstr "Tilkobling"

msgid "Photos"
msgstr "Bilder"

msgid "Appearance"
msgstr "Utseende"

msgid "Immich server"
msgstr "Immich-server"

msgid "Which photos"
msgstr "Hvilke bilder"

msgid "Updates"
msgstr "Oppdatering"

msgid "Size"
msgstr "Størrelse"

msgid "Style"
msgstr "Stil"

msgid "Caption"
msgstr "Tekst"

msgid "Server address"
msgstr "Serveradresse"

msgid "For example http://192.168.1.10:2283 or https://photos.example.com"
msgstr ""
"For eksempel http://192.168.1.10:2283 eller https://bilder.example.com"

msgid "API key"
msgstr "API-nøkkel"

msgid "Immich → Account Settings → API Keys → New API Key"
msgstr "Immich → Kontoinnstillinger → API-nøkler → Ny API-nøkkel"

msgid ""
"Create the API key in Immich with the permissions asset.read, asset.view and"
" face.read (plus album.read or person.read if you pick an album or a "
"person)."
msgstr ""
"Lag API-nøkkelen i Immich med tilgangene asset.read, asset.view og face.read"
" (og album.read eller person.read hvis du velger et album eller en person)."

msgid "Fetch new photos now"
msgstr "Hent nye bilder nå"

msgid "Show"
msgstr "Vis"

msgid "All photos"
msgstr "Alle bilder"

msgid "Favorites"
msgstr "Favoritter"

msgid "One album"
msgstr "Ett album"

msgid "One person"
msgstr "Én person"

msgid "Album or person name"
msgstr "Navn på album eller person"

msgid "Used when Show is set to one album or one person"
msgstr "Brukes når Vis er satt til ett album eller én person"

msgid "Include screenshots and saved images"
msgstr "Ta med skjermbilder og lagrede bilder"

msgid "Off: only photos taken with a camera"
msgstr "Av: bare bilder tatt med kamera"

msgid "Crop around faces"
msgstr "Beskjær rundt ansikter"

msgid "Uses Immich face detection so heads are not cut off."
msgstr "Bruker ansiktsgjenkjenningen i Immich, så hodene ikke kuttes."

