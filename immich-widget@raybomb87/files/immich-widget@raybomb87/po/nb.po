#: desklet.js:191
msgid "Right-click and choose Configure to connect to your Immich server."
msgstr "Høyreklikk og velg Konfigurer for å koble til Immich-serveren din."

#: desklet.js:193
msgid "Fetching photos…"
msgstr "Henter bilder …"

#: desklet.js:195
msgid "No photos yet."
msgstr "Ingen bilder ennå."

#: desklet.js:204 desklet.js:216
msgid "Mark as favorite"
msgstr "Merk som favoritt"

#: desklet.js:206
msgid "Don't show this photo again"
msgstr "Ikke vis dette bildet igjen"

#: desklet.js:216
msgid "Remove from favorites"
msgstr "Fjern fra favoritter"

